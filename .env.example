# Copy this file to .env and fill in the values for your institution.
# .env is listed in .gitignore and must never be committed.

# OMOP CDM database (Microsoft SQL Server, port 1433, schema dbo)
DATABASE_HOST=
DATABASE_DATABASE=
DATABASE_USER=
DATABASE_PASSWORD=

# Fully qualified CDM tables
CONCEPT_TABLE=[YOUR_CDM].[YOUR_SCHEMA].[concept]
CONCEPT_ANCESTOR_TABLE=[YOUR_CDM].[YOUR_SCHEMA].[concept_ancestor]
CONDITION_OCCURRENCE_TABLE=[YOUR_CDM].[YOUR_SCHEMA].[condition_occurrence]

# Optional: openFDA API key (without it, openFDA allows 1,000 requests per day)
OPENFDA_API_KEY=
